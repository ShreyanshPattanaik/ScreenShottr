<Window x:Class="ShottrClone.CapturePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenShottr Preview"
        Width="360"
        Height="280"
        MinWidth="300"
        MinHeight="220"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFE9E9E9" BorderBrush="#FFB8B8B8"
                BorderThickness="1" CornerRadius="4" Padding="4">
            <Image Name="PreviewImage" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Copy" Width="70" Margin="0,0,6,0" Click="Copy_Click" />
            <Button Content="Save…" Width="70" Margin="0,0,6,0" Click="Save_Click" />
            <Button Content="Edit" Width="70" Margin="0,0,6,0" Click="Edit_Click" />
            <Button Content="Close" Width="70" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
