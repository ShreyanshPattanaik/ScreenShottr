<Window x:Class="ShottrClone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenShottr Settings"
        Width="520"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="After capture" FontWeight="SemiBold" FontSize="16" />
        <ComboBox Grid.Row="1" Name="PostCaptureCombo" Margin="0,8,0,18" Height="32" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18">
            <CheckBox Name="AutoCopyCheck" Content="Copy automatically" Margin="0,0,24,0" />
            <CheckBox Name="AutoSaveCheck" Content="Save automatically" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Default save folder" FontWeight="SemiBold" />
        <Grid Grid.Row="4" Margin="0,8,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Name="SaveFolderText" Height="32" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="14,5"
                    Click="BrowseFolder_Click" />
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="Filename pattern" FontWeight="SemiBold" />
                <TextBox Name="FileNamePatternText" Height="32" Margin="0,8,0,0"
                         VerticalContentAlignment="Center" />
                <TextBlock Text="Tokens: {timestamp}, {date}, {time}"
                           Foreground="DimGray" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Image format" FontWeight="SemiBold" />
                <ComboBox Name="ImageFormatCombo" Height="32" Margin="0,8,0,0">
                    <ComboBoxItem Content="PNG" Tag="png" />
                    <ComboBoxItem Content="JPEG" Tag="jpg" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <CheckBox Grid.Row="6" Name="StartWithWindowsCheck"
                  Content="Start ScreenShottr with Windows"
                  VerticalAlignment="Top" Margin="0,24,0,0" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
