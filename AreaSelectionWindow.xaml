<Window x:Class="ShottrClone.AreaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#40000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Title="Area Selection">
    <Canvas Name="SelectionCanvas">
        <Rectangle Name="SelectionRectangle" Stroke="DodgerBlue" StrokeThickness="2" Fill="#40C0E8FF" Visibility="Collapsed" />
    </Canvas>
</Window> 